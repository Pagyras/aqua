            <div class="approach-card"><span>02</span><strong>Расчёт и подбор</strong></div>
            <div class="approach-card"><span>03</span><strong>Комплектация под объект</strong></div>
            <div class="approach-card"><span>04</span><strong>Сопровождение запуска</strong></div>
          </div>
        </div>
      </div>
    </section>

